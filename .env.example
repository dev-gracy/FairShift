# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Secret key for JWT signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Admin seed credentials (used by seed script only)
ADMIN_PASSWORD=change-me-before-deploy
WORKER_PASSWORD=change-me-before-deploy

# Environment: development | production
APP_ENV=development

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite:///./fairshift.db
